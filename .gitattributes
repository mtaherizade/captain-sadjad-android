# Normalise line endings inside the repository so the Linux CI build is safe.
* text=auto eol=lf

# The Gradle wrapper shell script MUST stay LF, otherwise bash on the Linux
# runner fails with "bad interpreter: /bin/sh^M".
gradlew text eol=lf
gradlew.bat text eol=crlf

# ---------------------------------------------------------------------------
# Binary assets: never apply ANY end-of-line conversion.
# This is critical - a single CRLF->LF rewrite corrupts a .bin/.glb mesh.
# ---------------------------------------------------------------------------
